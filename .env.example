# Autocode — copy to .env locally. Never commit real secrets.
# Run: ./scripts/setup.sh

# --- Host / paths ---
AUTOCODE_HOME=/opt/autocode
WORKSPACE_ROOT=/opt/workspaces
TZ=UTC

# --- Ollama (local primary) ---
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=coder-64k
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_CTX=65536

# --- Hermes ---
HERMES_API_TIMEOUT=1800
HERMES_CONFIG_DIR=~/.hermes

# --- Notion (create your own DBs — see docs/notion-setup.md) ---
# Integration: https://www.notion.so/my-integrations
# Share Build Queue, Agent Runs, and Escalation Log with the integration.
NOTION_TOKEN=
NOTION_BUILD_QUEUE_DB=
NOTION_AGENT_RUNS_DB=
NOTION_ESCALATION_LOG_DB=
NOTION_HUB_PAGE=

# --- Autopilot budgets ---
AUTOCODE_MAX_TASKS_PER_NIGHT=2
AUTOCODE_MAX_WALL_MINUTES=90
AUTOCODE_MAX_TOOL_ITERATIONS=40
AUTOCODE_MAX_LOCAL_ATTEMPTS=2
AUTOCODE_BRANCH_PREFIX=hermes
AUTOCODE_MIN_RAM_MB=2500
AUTOCODE_MIN_DISK_GB=5
AUTOCODE_MAYBE_LOCAL_MIN_RAM_MB=4000
# Cost profile (cheaper → more expensive). Direct XAI_API_KEY is expensive for agents.
#   cursor-grok   → Cursor Cloud → Grok Bot → Human  (recommended: Ultra + your Bot)
#   cursor-ultra  → Cursor Cloud only
#   claude-max    → Claude → Cursor → Human
#   metered       → Claude → Cursor → Grok Bot (metered Grok last)
#   default       → same as cursor-grok
AUTOCODE_COST_PROFILE=cursor-grok
# Which cloud is cheaper for you? cursor (Ultra pool) or grok (flat Bot/SuperGrok)
AUTOCODE_CLOUD_PREFERENCE=cursor
# Or fully custom ladder (overrides profile):
# AUTOCODE_COST_LADDER=Cursor Cloud,Grok Bot,Human
# Block raw xAI/OpenRouter meters; still allow AUTOCODE_GROK_DELEGATE_CMD
AUTOCODE_DISABLE_METERED_GROK=1

# --- GitHub (PRs from the device) ---
# Prefer: gh auth login   or an SSH deploy key (not a long-lived PAT in git).
GITHUB_TOKEN=
GH_HOST=github.com
# Repos Hermes may work in (space-separated clone URLs or owner/name)
WORKSPACE_REPOS=

# --- Telegram morning digest (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Progress pings during the night (1=on). Digest still uses send_telegram_digest.sh
AUTOCODE_TELEGRAM_PROGRESS=1
# Mark stuck if heartbeat older than this while running (seconds)
AUTOCODE_STUCK_SECONDS=900

# --- Optional paid fallbacks / cloud delegation — leave empty until needed ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
CURSOR_API_KEY=
# Shell command for Cursor Cloud handoff (receives AUTOCODE_DELEGATE_PAYLOAD)
AUTOCODE_CURSOR_DELEGATE_CMD=
# Shell command for Grok Bot webhook / Telegram / custom agent
# Receives AUTOCODE_DELEGATE_PAYLOAD (JSON path)
AUTOCODE_GROK_DELEGATE_CMD=
AUTOCODE_DELEGATE_TIMEOUT_SEC=120
AUTOCODE_CLAUDE_MODEL=claude-sonnet-4-20250514
AUTOCODE_GROK_MODEL=grok-2-latest
AUTOCODE_OPENROUTER_MODEL=x-ai/grok-2
