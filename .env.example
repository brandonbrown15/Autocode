# Autocode — copy to .env on the Jetson. Never commit real secrets.

# --- Host / paths ---
AUTOCODE_HOME=/opt/autocode
WORKSPACE_ROOT=/opt/workspaces
TZ=America/Chicago

# --- Ollama (local primary) ---
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=coder-64k
OLLAMA_KEEP_ALIVE=24h
# Prefer native /api/chat for num_ctx; Hermes may still use /v1 depending on version
OLLAMA_NUM_CTX=65536

# --- Hermes ---
HERMES_API_TIMEOUT=1800
# Path to Hermes config after install (typical)
HERMES_CONFIG_DIR=~/.hermes

# --- Notion (Local Coding Machine hub) ---
# Create an integration at https://www.notion.so/my-integrations
# Share Build Queue, Agent Runs, and Escalation Log with the integration.
NOTION_TOKEN=
NOTION_BUILD_QUEUE_DB=6b1e564b-106e-437e-ac99-5a9b66da379a
NOTION_BUILD_QUEUE_DS=5b5a8066-f174-46fa-9731-f28867fb8f88
NOTION_AGENT_RUNS_DB=3ce53ff0-b5d6-4996-9315-78b62602411d
NOTION_AGENT_RUNS_DS=a93aba88-1f0d-4edb-8856-f0029fc2c636
NOTION_ESCALATION_LOG_DB=e9034904-13af-4617-912d-e1e151085f79
NOTION_ESCALATION_LOG_DS=72ad8575-dd8b-445a-ac1a-03aed1d3bd9e
NOTION_HUB_PAGE=3dc9daf5-96d7-81d3-9a62-cad3a994e4a4

# --- Autopilot budgets ---
AUTOCODE_MAX_TASKS_PER_NIGHT=2
AUTOCODE_MAX_WALL_MINUTES=90
AUTOCODE_MAX_TOOL_ITERATIONS=40
AUTOCODE_MAX_LOCAL_ATTEMPTS=2
AUTOCODE_BRANCH_PREFIX=hermes

# --- GitHub (PRs from the Jetson) ---
# Prefer gh auth login / SSH deploy key over a long-lived PAT when possible.
GITHUB_TOKEN=
GH_HOST=github.com
DEFAULT_REPO_ROSE=brandonbrown15/ROSE

# --- Telegram morning digest ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional paid fallbacks (Phase 2b) — leave empty until needed ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
